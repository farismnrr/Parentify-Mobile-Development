<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/max_content_width"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_lg">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@string/parentify"
                    android:src="@drawable/ic_logo_paren" />

                <TextView
                    android:id="@+id/tv_parentify"
                    style="@style/TextAppearance.Parentify.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Selamat Datang, Bunda"
                    android:textColor="@color/md_theme_primary" />

                <TextView
                    android:id="@+id/tv_login"
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="Masuk untuk memantau gizi &amp; tumbuh kembang si kecil"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- Login Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_low"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Email / Username Label & Input -->
                    <TextView
                        android:id="@+id/tv_login_email"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email atau Username Bunda"
                        android:textColor="@color/md_theme_onSurface" />

                    <EditText
                        android:id="@+id/et_login_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height_md"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@drawable/ic_box_text"
                        android:hint="bunda@email.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:text="bunda.sarah@parentify.id"
                        android:textColor="@color/md_theme_onSurface"
                        android:textColorHint="@color/md_theme_outline"
                        android:textSize="@dimen/text_body_md" />

                    <!-- Password Label & Input -->
                    <TextView
                        android:id="@+id/tv_login_password"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Kata Sandi"
                        android:textColor="@color/md_theme_onSurface" />

                    <EditText
                        android:id="@+id/et_login_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height_md"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@drawable/ic_box_text"
                        android:hint="Masukkan kata sandi"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:text="bunda123"
                        android:textColor="@color/md_theme_onSurface"
                        android:textColorHint="@color/md_theme_outline"
                        android:textSize="@dimen/text_body_md" />

                    <!-- Forgot Password Link -->
                    <TextView
                        android:id="@+id/tv_forgot_password"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:padding="@dimen/spacing_xxs"
                        android:text="Lupa Kata Sandi?"
                        android:textColor="@color/md_theme_primary" />

                    <!-- Demo Account Info Chip -->
                    <LinearLayout
                        android:id="@+id/btn_fill_demo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/ic_box_text"
                        android:backgroundTint="@color/md_theme_primaryContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xs">

                        <TextView
                            style="@style/TextAppearance.Parentify.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ Akun Demo Terisi: bunda.sarah@parentify.id"
                            android:textColor="@color/md_theme_primary" />
                    </LinearLayout>

                    <!-- Login Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        style="@style/Widget.Parentify.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_md"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="MASUK" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Register Footer Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum memiliki akun?" />

                <TextView
                    android:id="@+id/tv_register"
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:padding="@dimen/spacing_xs"
                    android:text="Daftar di sini"
                    android:textColor="@color/md_theme_primary"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>