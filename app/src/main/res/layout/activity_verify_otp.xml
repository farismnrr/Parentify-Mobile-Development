<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context="com.example.newsapp.ui.detail.VerifyOTP">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xl">

            <ImageView
                android:id="@+id/iv_icon_msg"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_msg2" />

            <TextView
                android:id="@+id/tv_otp_verif"
                style="@style/TextAppearance.Parentify.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/txt_otp_verifi"
                android:textColor="@color/md_theme_primary" />

            <TextView
                android:id="@+id/tv_enter_verif"
                style="@style/TextAppearance.Parentify.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="Masukkan kode 6 digit yang dikirimkan ke"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tv_phone_number"
                style="@style/TextAppearance.Parentify.TitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textColor="@color/md_theme_primary"
                tools:text="+628123456789" />

            <!-- OTP Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_low"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- 6 Digit PIN Row -->
                    <LinearLayout
                        android:id="@+id/otpCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_otp1"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:background="@drawable/ic_box_text"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_otp2"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_otp3"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_otp4"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_otp5"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_otp6"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Resend Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_otp_nosend"
                            style="@style/TextAppearance.Parentify.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/txt_otp_nosend" />

                        <TextView
                            android:id="@+id/tv_resend_otp_reg"
                            style="@style/TextAppearance.Parentify.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:padding="@dimen/spacing_xs"
                            android:text="@string/txt_resend_otp_reg"
                            android:textColor="@color/md_theme_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Verify Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verifiy_otp"
                        style="@style/Widget.Parentify.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_md"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/txt_verify_otp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
