<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true"
    tools:context=".ui.detection.CameraFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Top Header -->
        <TextView
            android:id="@+id/titleDetection"
            style="@style/TextAppearance.Parentify.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pindai Nutrisi Makanan"
            android:textColor="@color/md_theme_primary" />

        <TextView
            style="@style/TextAppearance.Parentify.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Arahkan lensa ke hidangan si kecil untuk analisis gizi instan" />

        <!-- Camera Viewfinder Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_viewfinder"
            android:layout_width="match_parent"
            android:layout_height="370dp"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardBackgroundColor="@color/md_theme_onSurface"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_medium"
            app:strokeColor="@color/md_theme_primary"
            app:strokeWidth="1.5dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Live Camera Feed Simulation -->
                <ImageView
                    android:id="@+id/iv_camera_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Pratinjau Lensa Kamera"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo_paren" />

                <!-- Dark Vignette Overlay for Real Camera Feel -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#2E000000" />

                <!-- Top Camera HUD: Flash, AI Mode, Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_md">

                    <!-- Flash Toggle -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardBackgroundColor="#73000000"
                        app:cardCornerRadius="@dimen/radius_full"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/btn_camera_flash"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Lampu Kilat"
                            android:padding="9dp"
                            android:src="@drawable/ic_flash_on"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Live AI Lens Pill -->
                    <TextView
                        android:id="@+id/tv_ai_mode_badge"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_box_text"
                        android:backgroundTint="#B3000000"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="5dp"
                        android:text="● AI NutriLens™ 4K"
                        android:textColor="@color/white"
                        android:textSize="11.5sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Grid Indicator -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardBackgroundColor="#73000000"
                        app:cardCornerRadius="@dimen/radius_full"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/btn_camera_grid"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Garis Panduan"
                            android:padding="9dp"
                            android:src="@drawable/ic_grid_on"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Central Focus Reticle & Corner Brackets -->
                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center">

                    <!-- Top Left Corner Bracket -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_gravity="top|start"
                        android:background="@color/white" />
                    <View
                        android:layout_width="3dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|start"
                        android:background="@color/white" />

                    <!-- Top Right Corner Bracket -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_gravity="top|end"
                        android:background="@color/white" />
                    <View
                        android:layout_width="3dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:background="@color/white" />

                    <!-- Bottom Left Corner Bracket -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom|start"
                        android:background="@color/white" />
                    <View
                        android:layout_width="3dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|start"
                        android:background="@color/white" />

                    <!-- Bottom Right Corner Bracket -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom|end"
                        android:background="@color/white" />
                    <View
                        android:layout_width="3dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:background="@color/white" />

                    <!-- Center Pulsing Focus Target -->
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ic_box_text"
                        android:backgroundTint="@color/md_theme_primary" />
                </FrameLayout>

                <!-- Floating Live Target Recognition Tag -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/ic_box_text"
                    android:backgroundTint="#D91F1A1C"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tv_active_food_tag"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:text="Objek Terdeteksi: Sup Ayam &amp; Sayur (98.4%)"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_check_circle_24"
                        app:drawableTint="@color/md_theme_primary" />
                </LinearLayout>

                <!-- Shutter Flash Animation Layer -->
                <View
                    android:id="@+id/v_camera_flash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@color/white" />

                <!-- AI Scanning Overlay -->
                <LinearLayout
                    android:id="@+id/ll_scanning_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D9000000"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:indeterminateTint="@color/md_theme_primary" />

                    <TextView
                        style="@style/TextAppearance.Parentify.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Menganalisis Hidangan..."
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/TextAppearance.Parentify.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Menghitung estimasi kalori, makronutrisi &amp; kecocokan usia anak"
                        android:textAlignment="center"
                        android:textColor="@color/white" />
                </LinearLayout>

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Professional Camera Controls Bar (Pure Vector Icons: Gallery, Shutter Button, Switch Camera) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_lg">

            <!-- Gallery Button with Material Vector Icon -->
            <LinearLayout
                android:id="@+id/btn_camera_gallery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardBackgroundColor="@color/md_theme_surface"
                    app:cardCornerRadius="@dimen/radius_full"
                    app:cardElevation="@dimen/elevation_low"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Buka Galeri Foto"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_gallery"
                        app:tint="@color/md_theme_onSurface" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/TextAppearance.Parentify.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Galeri"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>

            <!-- Center Primary Shutter Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                app:cardBackgroundColor="@color/md_theme_primary"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="@dimen/elevation_medium"
                app:strokeColor="@color/white"
                app:strokeWidth="4dp">

                <ImageView
                    android:id="@+id/actionOpenCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Ambil Foto &amp; Analisis"
                    android:padding="@dimen/spacing_md"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Flip / Switch Camera Button with Material Vector Icon -->
            <LinearLayout
                android:id="@+id/btn_camera_flip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardBackgroundColor="@color/md_theme_surface"
                    app:cardCornerRadius="@dimen/radius_full"
                    app:cardElevation="@dimen/elevation_low"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Putar Lensa Kamera"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_camera_switch"
                        app:tint="@color/md_theme_onSurface" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/TextAppearance.Parentify.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Putar Lensa"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>

        </LinearLayout>

        <!-- Quality Note Card with Vector Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/md_theme_primary" />

                <TextView
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Arahkan lensa tepat ke piring makanan si kecil. AI akan mendeteksi kandungan gizi makro dan keamanan teksturnya."
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>