<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.auth.ForgotActivity">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_forgot_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Kembali"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back_24dp"
                app:tint="@color/md_theme_onSurface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Parentify.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="Pemulihan Akun" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/max_content_width"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.35">

                <!-- Hero Icon & Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/spacing_md">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        app:cardBackgroundColor="@color/md_theme_primaryContainer"
                        app:cardCornerRadius="@dimen/radius_full"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/md_theme_outlineVariant"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="@dimen/spacing_md"
                            android:src="@drawable/ic_logo_paren" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/TextAppearance.Parentify.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="Lupa Kata Sandi?"
                        android:textColor="@color/md_theme_primary" />

                    <TextView
                        style="@style/TextAppearance.Parentify.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="Jangan khawatir Bunda, masukkan data akun Anda untuk membuat kata sandi baru."
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/md_theme_surface"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="@dimen/elevation_low"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <!-- Email / Username -->
                        <TextView
                            style="@style/TextAppearance.Parentify.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email atau Username Bunda"
                            android:textColor="@color/md_theme_onSurface" />

                        <EditText
                            android:id="@+id/et_forgot_uname"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_md"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:hint="Contoh: bunda@email.com"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:textColor="@color/md_theme_onSurface"
                            android:textColorHint="@color/md_theme_outline"
                            android:textSize="@dimen/text_body_md" />

                        <!-- New Password -->
                        <TextView
                            style="@style/TextAppearance.Parentify.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Kata Sandi Baru"
                            android:textColor="@color/md_theme_onSurface" />

                        <EditText
                            android:id="@+id/et_forgot_sandi"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_md"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:hint="Minimal 6 karakter baru"
                            android:inputType="textPassword"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:textColor="@color/md_theme_onSurface"
                            android:textColorHint="@color/md_theme_outline"
                            android:textSize="@dimen/text_body_md" />

                        <!-- Confirm New Password -->
                        <TextView
                            style="@style/TextAppearance.Parentify.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Konfirmasi Kata Sandi Baru"
                            android:textColor="@color/md_theme_onSurface" />

                        <EditText
                            android:id="@+id/et_confirm_sandi"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height_md"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:background="@drawable/ic_box_text"
                            android:hint="Ulangi kata sandi baru"
                            android:inputType="textPassword"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:textColor="@color/md_theme_onSurface"
                            android:textColorHint="@color/md_theme_outline"
                            android:textSize="@dimen/text_body_md" />

                        <!-- Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset"
                            style="@style/Widget.Parentify.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height_md"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:text="Simpan Kata Sandi Baru" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Back to Login Link -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.Parentify.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingat kata sandi Anda?" />

                    <TextView
                        android:id="@+id/tv_back_to_login"
                        style="@style/TextAppearance.Parentify.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:padding="@dimen/spacing_xs"
                        android:text="Masuk di sini"
                        android:textColor="@color/md_theme_primary"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
