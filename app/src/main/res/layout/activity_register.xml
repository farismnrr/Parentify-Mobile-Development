<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true"
    tools:context=".ui.auth.RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/max_content_width"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/iv_reg_logo"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@string/parentify"
                    android:src="@drawable/ic_logo_paren" />

                <TextView
                    style="@style/TextAppearance.Parentify.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Daftar Akun Bunda"
                    android:textColor="@color/md_theme_primary" />

                <TextView
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="Sahabat kehamilan &amp; tumbuh kembang si buah hati"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- Register Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_low"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Username -->
                    <TextView
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Bunda / Panggilan"
                        android:textColor="@color/md_theme_onSurface" />

                    <EditText
                        android:id="@+id/register_uname"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height_md"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@drawable/ic_box_text"
                        android:hint="Contoh: Bunda Sarah"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/md_theme_onSurface"
                        android:textColorHint="@color/md_theme_outline"
                        android:textSize="@dimen/text_body_md" />

                    <!-- Email -->
                    <TextView
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Alamat Email"
                        android:textColor="@color/md_theme_onSurface" />

                    <EditText
                        android:id="@+id/register_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height_md"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@drawable/ic_box_text"
                        android:hint="bunda@email.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/md_theme_onSurface"
                        android:textColorHint="@color/md_theme_outline"
                        android:textSize="@dimen/text_body_md" />

                    <!-- Password -->
                    <TextView
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Kata Sandi"
                        android:textColor="@color/md_theme_onSurface" />

                    <EditText
                        android:id="@+id/register_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height_md"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@drawable/ic_box_text"
                        android:hint="Minimal 6 karakter"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/md_theme_onSurface"
                        android:textColorHint="@color/md_theme_outline"
                        android:textSize="@dimen/text_body_md" />

                    <!-- Confirm Password -->
                    <TextView
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Ulangi Kata Sandi"
                        android:textColor="@color/md_theme_onSurface" />

                    <EditText
                        android:id="@+id/register_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height_md"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@drawable/ic_box_text"
                        android:hint="Konfirmasi kata sandi Anda"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/md_theme_onSurface"
                        android:textColorHint="@color/md_theme_outline"
                        android:textSize="@dimen/text_body_md" />

                    <!-- Signup Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_signup"
                        style="@style/Widget.Parentify.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_md"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="DAFTAR SEKARANG" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Login Link Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sudah memiliki akun?" />

                <TextView
                    android:id="@+id/tv_login"
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:padding="@dimen/spacing_xs"
                    android:text="Masuk di sini"
                    android:textColor="@color/md_theme_primary"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
