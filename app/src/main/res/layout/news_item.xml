<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_low"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_sm">

        <!-- Article Thumbnail Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_image"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/news_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/news_image"
                android:scaleType="centerCrop"
                tools:srcCompat="@drawable/ic_logo_paren" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Article Category Badge -->
        <TextView
            android:id="@+id/news_source"
            style="@style/TextAppearance.Parentify.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/ic_box_text"
            android:backgroundTint="@color/md_theme_primaryContainer"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/md_theme_primary"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_source"
            app:drawableTint="@color/md_theme_primary"
            app:layout_constraintStart_toEndOf="@id/card_image"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Dunia Bunda" />

        <!-- Article Title -->
        <TextView
            android:id="@+id/news_title"
            style="@style/TextAppearance.Parentify.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="2"
            android:textColor="#1F1A1C"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_image"
            app:layout_constraintTop_toBottomOf="@id/news_source"
            tools:text="Tips Menjaga Kebugaran &amp; Nutrisi Ibu Menyusui (ASI Booster Alami)" />

        <!-- Article Snippet -->
        <TextView
            android:id="@+id/news_text"
            style="@style/TextAppearance.Parentify.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_image"
            app:layout_constraintTop_toBottomOf="@id/news_title"
            tools:text="Bahan pangan lokal seperti daun katuk dan kelor terbukti efektif..." />

        <!-- Published Date -->
        <TextView
            android:id="@+id/news_date"
            style="@style/TextAppearance.Parentify.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_theme_outline"
            android:textSize="11.5sp"
            app:drawableStartCompat="@drawable/ic_date"
            app:drawableTint="@color/md_theme_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_image"
            app:layout_constraintTop_toBottomOf="@id/news_text"
            tools:text="02 Oktober 2026" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>