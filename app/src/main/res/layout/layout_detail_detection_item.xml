<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="dataItemBind"
            type="com.example.newsapp.data.model.food.ListInformation" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md">

            <!-- Circular Icon Badge -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ic_box_text"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/md_theme_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Content Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_box_text"
                        android:backgroundTint="@color/md_theme_primaryContainer"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="@{dataItemBind.status}"
                        android:textColor="@color/md_theme_primary"
                        android:textStyle="bold"
                        tools:text="Sangat Baik" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTexture"
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{dataItemBind.textureString}"
                        android:textColor="@color/md_theme_outline"
                        android:textSize="11.5sp"
                        tools:text="Tekstur: Lembut" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInformation"
                    style="@style/TextAppearance.Parentify.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@{dataItemBind.information}"
                    android:textColor="#262022"
                    android:textSize="13.5sp"
                    tools:text="Kaldu ayam kaya elektrolit alami yang menghangatkan tubuh Bunda dan si kecil saat kurang enak badan." />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>