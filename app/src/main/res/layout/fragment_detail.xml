<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.detail.DetailFragment">

    <!-- Clean Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/ll_detail_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_detail_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Kembali"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back_24dp"
                app:tint="@color/md_theme_onSurface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Parentify.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="Panduan &amp; Tips Bunda"
            android:textColor="@color/md_theme_onSurface" />

        <!-- Favorite Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_detail_favorite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Simpan Favorit"
                android:scaleType="centerInside"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/md_theme_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Share Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_xs"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/radius_full"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_detail_share"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Bagikan"
                android:scaleType="centerInside"
                android:src="@drawable/ic_share"
                app:tint="@color/md_theme_onSurface" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_detail_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xxl">

            <!-- Hero Image Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_low"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/news_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/news_image"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/ic_logo_paren" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Metadata Row: Source Category & Date Reading Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/news_source"
                    style="@style/TextAppearance.Parentify.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_box_text"
                    android:backgroundTint="@color/md_theme_primaryContainer"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="4dp"
                    android:textColor="@color/md_theme_primary"
                    android:textStyle="bold"
                    tools:text="Kesehatan Ibu &amp; Janin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:text="•"
                    android:textColor="@color/md_theme_outline" />

                <TextView
                    android:id="@+id/news_date"
                    style="@style/TextAppearance.Parentify.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_outline"
                    tools:text="01 Oktober 2026 • 5 menit baca" />
            </LinearLayout>

            <!-- Article Title -->
            <TextView
                android:id="@+id/news_title"
                style="@style/TextAppearance.Parentify.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:lineSpacingMultiplier="1.25"
                android:textColor="#1F1A1C"
                android:textSize="21sp"
                tools:text="Panduan Lengkap Asupan Nutrisi &amp; Asam Folat untuk Ibu Hamil Trimester 1–3" />

            <!-- Author & Medical Reviewer Row (Editorial Clean Layout) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/ic_box_text"
                    android:backgroundTint="@color/md_theme_primaryContainer"
                    android:contentDescription="Dokter Spesialis"
                    android:padding="9dp"
                    android:src="@drawable/ic_stethoscope"
                    app:tint="@color/md_theme_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/news_author"
                        style="@style/TextAppearance.Parentify.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="14sp"
                        tools:text="dr. Amanda Putri, Sp.OG" />

                    <TextView
                        style="@style/TextAppearance.Parentify.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Ditinjau secara Medis • Terverifikasi Parentify"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hairline Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@color/md_theme_outlineVariant" />

            <!-- Article Body Text (Clean Editorial typography without bulky bordered card) -->
            <TextView
                android:id="@+id/news_text"
                style="@style/TextAppearance.Parentify.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:lineSpacingMultiplier="1.6"
                android:textColor="#2E2729"
                android:textSize="15.5sp"
                tools:text="Isi artikel panduan lengkap yang nyaman dibaca seperti artikel majalah kesehatan modern..." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar / Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_action_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="@dimen/elevation_medium"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/go_to_source"
            style="@style/Widget.Parentify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_md"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginVertical="@dimen/spacing_sm"
            android:text="Bagikan Panduan untuk Keluarga"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconTint="@color/md_theme_onPrimary" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>