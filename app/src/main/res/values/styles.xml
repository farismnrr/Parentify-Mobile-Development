<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================= -->
    <!-- Parentify Design System - Typography Text Appearances             -->
    <!-- Premium Editorial Typography powered by Plus Jakarta Sans         -->
    <!-- ================================================================= -->
    <style name="TextAppearance.Parentify.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Parentify.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Parentify.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Parentify.TitleSmall" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <!-- Editorial Long-form Body Text for Articles -->
    <style name="TextAppearance.Parentify.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#2E2729</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Parentify.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Parentify.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ================================================================= -->
    <!-- Parentify Design System - Buttons                                 -->
    <!-- ================================================================= -->
    <style name="Widget.Parentify.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:minHeight">@dimen/button_height_md</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="elevation">@dimen/elevation_none</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Parentify.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="strokeColor">@color/md_theme_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:minHeight">@dimen/button_height_md</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Parentify.Button.Outlined" parent="Widget.Parentify.Button.Secondary" />

    <style name="Widget.Parentify.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <!-- ================================================================= -->
    <!-- Parentify Design System - Cards                                   -->
    <!-- ================================================================= -->
    <style name="Widget.Parentify.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Parentify.Card.Elevated" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_medium</item>
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ================================================================= -->
    <!-- Parentify Design System - Text Input                              -->
    <!-- ================================================================= -->
    <style name="Widget.Parentify.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/md_theme_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/md_theme_primary</item>
        <item name="android:textColorHint">@color/md_theme_onSurfaceVariant</item>
    </style>
</resources>
