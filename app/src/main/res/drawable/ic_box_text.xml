<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused / Active State -->
    <item android:state_enabled="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="14dp"/>
            <stroke android:color="@color/md_theme_primary" android:width="2dp"/>
        </shape>
    </item>

    <!-- Unfocused / Inactive State: Clearly visible border -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_background_unfocused" />
            <corners android:radius="14dp"/>
            <stroke android:color="@color/input_border_unfocused" android:width="1.5dp"/>
        </shape>
    </item>

</selector>